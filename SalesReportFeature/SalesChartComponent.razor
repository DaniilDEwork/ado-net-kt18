@page "/saleschart"
@page "/saleschart/line"
@inject NavigationManager Navigation

<PageTitle>График продаж - КТ-18</PageTitle>
<h1>График продаж</h1>
<div class="chart-links">
    <a href="/saleschart">Столбчатый график</a>
    <a href="/saleschart/line">Линейный график</a>
</div>
<div class="stats">
    <span>Товаров: <strong>@salesService.Sales.Count</strong></span>
    <span>Общая сумма: <strong>@Money(salesService.Sales.Sum(item => item.Amount)) ₽</strong></span>
</div>

@if (salesService.Sales.Count == 0)
{
    <p class="hint">Нет данных для графика</p>
}
else
{
    <div class="chart-wrap">
        <svg class="sales-chart" viewBox="0 0 900 440" role="img" aria-labelledby="chart-title chart-description">
            <title id="chart-title">@(IsLine ? "Линейный график продаж" : "Столбчатый график продаж")</title>
            <desc id="chart-description">Суммы продаж в рублях по товарам, точные значения приведены в таблице</desc>
            @for (var step = 0; step <= 4; step++)
            {
                var y = 300 - step * 65;
                <g>
                    <line x1="100" y1="@y" x2="860" y2="@y" stroke="#dbe2e8" />
                    <text x="88" y="@(y + 4)" text-anchor="end">@Money(Maximum * step / 4)</text>
                </g>
            }
            <line x1="100" y1="40" x2="100" y2="300" stroke="#607d8b" />
            <line x1="100" y1="300" x2="860" y2="300" stroke="#607d8b" />
            <g><text x="100" y="23">Продажи, ₽</text></g>
            @if (IsLine)
            {
                <polyline points="@LinePoints()" fill="none" stroke="#185a9d" stroke-width="3" />
            }
            @for (var index = 0; index < salesService.Sales.Count; index++)
            {
                var item = salesService.Sales[index];
                var x = X(index);
                var y = Y(item.Amount);
                <g @key="item.Id">
                    @if (IsLine)
                    {
                        <circle cx="@Number(x)" cy="@Number(y)" r="5" fill="#185a9d">
                            <title>@item.Product: @Money(item.Amount) ₽</title>
                        </circle>
                    }
                    else
                    {
                        <rect x="@Number(x - BarWidth / 2)" y="@Number(y)" width="@Number(BarWidth)"
                              height="@Number(300 - y)" fill="#385777" rx="3">
                            <title>@item.Product: @Money(item.Amount) ₽</title>
                        </rect>
                    }
                    <text x="@Number(x)" y="@Number(y - 10)" text-anchor="middle">@item.Amount.ToString("0.##", Russian)</text>
                    <text transform="@($"translate({Number(x)}, 324) rotate(-40)")" text-anchor="end">@ShortName(item.Product)</text>
                </g>
            }
        </svg>
    </div>
}

<h2>@(editingId is null ? "Добавить товар" : "Изменить товар")</h2>
<form @onsubmit="Save" @onsubmit:preventDefault>
    <div class="form-grid">
        <div>
            <label for="product-name">Название товара</label>
            <input id="product-name" @bind="productName" @bind:event="oninput" maxlength="24" />
        </div>
        <div>
            <label for="sales-amount">Сумма продаж, ₽</label>
            <input id="sales-amount" @bind="amountText" @bind:event="oninput" inputmode="decimal" maxlength="14" />
        </div>
    </div>
    <div class="actions">
        <button type="submit">@(editingId is null ? "Добавить" : "Сохранить")</button>
        @if (editingId is not null)
        {
            <button type="button" @onclick="Cancel">Отмена</button>
        }
    </div>
</form>
@if (error is not null)
{
    <p class="error" role="alert">@error</p>
}
@if (message is not null)
{
    <p class="success" role="status">@message</p>
}

@if (salesService.Sales.Count > 0)
{
    <div class="table-wrap">
        <table>
            <thead><tr><th>Товар</th><th>Сумма продаж, ₽</th><th>Действия</th></tr></thead>
            <tbody>
                @foreach (var item in salesService.Sales)
                {
                    <tr @key="item.Id">
                        <td>@item.Product</td>
                        <td>@Money(item.Amount)</td>
                        <td class="table-actions">
                            <button type="button" @onclick="() => Edit(item)">Изменить</button>
                            <button type="button" class="danger" @onclick="() => Delete(item.Id)">Удалить</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
<div class="actions">
    <button type="button" @onclick="Reset">Исходные данные</button>
    <button type="button" class="danger" @onclick="Clear" disabled="@(salesService.Sales.Count == 0)">Очистить данные</button>
</div>

@code {
    private readonly SalesDataService salesService = new();
    private static readonly CultureInfo Russian = CultureInfo.GetCultureInfo("ru-RU");
    private string productName = "";
    private string amountText = "";
    private Guid? editingId;
    private string? error;
    private string? message;
    private bool IsLine => new Uri(Navigation.Uri).AbsolutePath.TrimEnd('/').EndsWith("/line", StringComparison.OrdinalIgnoreCase);
    private decimal Maximum => Math.Max(1000, Math.Ceiling(salesService.Sales.Max(item => item.Amount) / 1000) * 1000);
    private double BarWidth => Math.Min(100, 760.0 / salesService.Sales.Count * 0.65);

    private double X(int index) => 100 + (index + 0.5) * 760.0 / salesService.Sales.Count;
    private double Y(decimal amount) => 300 - (double)(amount / Maximum) * 260;
    private static string Number(double value) => value.ToString("0.##", CultureInfo.InvariantCulture);
    private static string Money(decimal value) => value.ToString("N2", Russian);
    private static string ShortName(string value) => value.Length > 12 ? value[..11] + "…" : value;
    private string LinePoints() => string.Join(" ", salesService.Sales.Select((item, index) => $"{Number(X(index))},{Number(Y(item.Amount))}"));

    private void Save()
    {
        message = null;
        if (!decimal.TryParse(amountText.Replace(',', '.'), NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
            CultureInfo.InvariantCulture, out var amount))
        {
            error = "Введите сумму продаж числом";
            return;
        }
        error = salesService.Save(editingId, productName, amount);
        if (error is not null) return;
        message = editingId is null ? "Товар добавлен, график обновлён" : "Изменения сохранены, график обновлён";
        ClearForm();
    }

    private void Edit(SalesData item)
    {
        editingId = item.Id;
        productName = item.Product;
        amountText = item.Amount.ToString("0.##", CultureInfo.InvariantCulture);
        error = null;
        message = null;
    }

    private void Cancel()
    {
        ClearForm();
        message = "Изменение отменено";
    }

    private void Delete(Guid id)
    {
        salesService.Delete(id);
        if (editingId == id) ClearForm();
        error = null;
        message = "Товар удалён, график обновлён";
    }

    private void Reset()
    {
        salesService.Reset();
        ClearForm();
        message = "Исходные данные восстановлены";
    }

    private void Clear()
    {
        salesService.Sales.Clear();
        ClearForm();
        message = "Данные очищены";
    }

    private void ClearForm()
    {
        editingId = null;
        productName = "";
        amountText = "";
        error = null;
    }
}
