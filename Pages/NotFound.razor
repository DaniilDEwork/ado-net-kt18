@page "/not-found"
@inject FeatureLoadState LoadState
@inject NavigationManager Navigation

<PageTitle>Страница не найдена - КТ-18</PageTitle>
@if (LoadState.Error is not null)
{
    <h1>Ошибка загрузки</h1>
    <p class="error" role="alert">@LoadState.Error</p>
    <button @onclick="Reload">Повторить загрузку</button>
}
else
{
    <h1>Страница не найдена</h1>
    <p>Проверьте адрес или вернитесь на главную страницу</p>
}
<a class="button" href="/">На главную</a>

@code {
    private void Reload() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
}
