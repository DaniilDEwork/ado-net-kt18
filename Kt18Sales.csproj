<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <DefaultItemExcludes>$(DefaultItemExcludes);SalesReportFeature/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.12" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.12" PrivateAssets="all" />
    <ProjectReference Include="SalesReportFeature/SalesReportFeature.csproj" />
    <BlazorWebAssemblyLazyLoad Include="SalesReportFeature.wasm" />
    <TrimmerRootAssembly Include="SalesReportFeature" />
  </ItemGroup>
</Project>
